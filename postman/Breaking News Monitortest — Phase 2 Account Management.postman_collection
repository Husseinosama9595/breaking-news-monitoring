      "name": "A. Authentication",
      "item": [
        {
          "name": "Admin login — valid credentials",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('jwtToken');\nconst username = pm.environment.get('adminUsername');\nconst password = pm.environment.get('adminPassword');\nif (typeof username !== 'string' || !username || typeof password !== 'string' || !password) {\n  throw new Error('Set adminUsername and adminPassword in the selected local Postman environment.');\n}\npm.variables.set('adminUsernameJson', JSON.stringify(username));\npm.variables.set('adminPasswordJson', JSON.stringify(password));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });\nconst body = pm.response.json();\npm.test('Login returns the implemented token contract', function () {\n  pm.expect(body.accessToken).to.be.a('string').and.not.empty;\n  pm.expect(body.tokenType).to.eql('Bearer');\n  pm.expect(body.expiresIn).to.eql(28800);\n});\nif (pm.response.code === 200 && pm.response.json().accessToken) pm.collectionVariables.set('jwtToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": {{adminUsernameJson}},\n  \"password\": {{adminPasswordJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
