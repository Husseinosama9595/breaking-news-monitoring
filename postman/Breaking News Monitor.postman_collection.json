    {
      "name": "Global Rate Limit — 121 iterations, run last",
      "description": "The Express-wide limiter allows 120 requests per minute. Run this one-request folder with 121 Runner iterations, no delay, after restarting the backend. Reset globalRateLimitCount to 0 first. The first 120 responses should be 200; the final response should be 429. This temporarily rate-limits the Postman client IP across all API routes.",
      "item": [
        {
          "name": "Global limit probe (configure Runner for 121 iterations)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health/live" },
            "description": "In Collection Runner, run this folder for 121 iterations with no delay. Restart the backend first, and reset the globalRateLimitCount collection variable to 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = Number(pm.collectionVariables.get('globalRateLimitCount') || '0') + 1;",
                  "pm.collectionVariables.set('globalRateLimitCount', String(attempt));",
                  "if (attempt <= 120) {",
                  "  pm.test('Global request ' + attempt + ' is below the limit', function () { pm.response.to.have.status(200); });",
                  "} else {",
                  "  pm.test('Global request 121 is rate limited', function () { pm.response.to.have.status(429); });",
                  "  pm.test('Global limiter uses the configured default response', function () { pm.expect(pm.response.text()).to.eql('Too many requests, please try again later.'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
