NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Local MongoDB Community Server. Keep credentials out of source control.
MONGODB_URI=mongodb://localhost:27017/BreakingNews

# Optional. Leave blank to run without Redis/BullMQ.
REDIS_URL=redis://127.0.0.1:6379

# Feed polling interval defaults to 45 seconds; overall per-account request timeout defaults to 10 seconds.
FEED_POLL_INTERVAL_MS=45000
FEED_POLL_TIMEOUT_MS=10000
FEED_POLL_CONCURRENCY=3
FEED_POLL_JITTER_MS=1000
# Heuristic age threshold for the newest valid post timestamp in a successful feed.
# This is not a promise about Nitter's historical retention or expected posting cadence.
FEED_FRESHNESS_MAX_AGE_MS=21600000

# Provider selection: `account` respects each MonitoredAccount.providerName;
# `mock` or `nitter` forces that provider for all monitored X accounts.
# Default keeps the existing per-account behavior (normally MockNewsProvider).
FEED_PROVIDER=account

# Public Nitter RSS instances, tried in order. Each failing instance is cooled down
# temporarily so healthy fallbacks are used without repeating its timeout every poll.
NITTER_INSTANCES=https://xitter.cf,https://nitter.gq
NITTER_INSTANCE_TIMEOUT_MS=4000
NITTER_INSTANCE_COOLDOWN_MS=60000

# BullMQ processing and MongoDB recovery. Redis is optional; pending work stays in MongoDB.
POST_JOB_MAX_ATTEMPTS=5
POST_JOB_BACKOFF_MS=1000
POST_RECOVERY_INTERVAL_MS=5000
POST_STALE_AFTER_MS=120000
POST_RECOVERY_BATCH_SIZE=100
POST_WORKER_CONCURRENCY=5
QUEUE_RUNTIME_CHECK_INTERVAL_MS=5000

# Optional Telegram channel delivery. Leave both credentials blank to keep notifications disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=10000
TELEGRAM_MIN_INTERVAL_MS=1100
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_BACKOFF_MS=2000
# Use at least 32 random characters. Example generator:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional comma-separated exact origins. FRONTEND_URL remains allowed too.
EXTRA_CORS_ORIGINS=
